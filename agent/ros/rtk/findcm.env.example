# FindCM credentials are secrets: copy this file outside Git and chmod 600.
# This vehicle uses its existing 4G network and injects RTCM3 through G70 USB.
DWC_RTK_PROVIDER=qianxun_findcm
DWC_RTK_CORRECTION_MODE=ntrip_client
DWC_RTK_NTRIP_HOST=rtk.ntrip.qxwz.com
DWC_RTK_NTRIP_PORT=8002
DWC_RTK_NTRIP_MOUNTPOINT=AUTO
DWC_RTK_NTRIP_USERNAME=replace_me
DWC_RTK_NTRIP_PASSWORD=replace_me
DWC_RTK_SERIAL_DEVICE=/dev/wheeltec_gnss
DWC_RTK_NTRIP_GGA_TOPIC=/gps/nmea_sentence
DWC_RTK_NTRIP_STATUS_FILE=/tmp/devices_web_control_ntrip_status.json

# ROS topic/frame overrides (confirm on the real vehicle before enabling motion).
DWC_RTK_GPS_TOPIC=/gps/fix
DWC_RTK_GGA_TOPIC=/gnss/gpgga
DWC_RTK_IMU_TOPIC=/imu
DWC_RTK_ODOM_TOPIC=/odom
DWC_RTK_SCAN_TOPIC=/scan
DWC_RTK_BASE_FRAME=base_footprint
DWC_RTK_ODOM_FRAME=odom_combined
DWC_RTK_GPS_FRAME=navsat_link
# Antenna lever arm in base_footprint coordinates; measure before final accuracy acceptance.
DWC_RTK_GPS_OFFSET_X=0.0
DWC_RTK_GPS_OFFSET_Y=0.0
DWC_RTK_GPS_OFFSET_Z=0.0

# Road survey sampling: sparse on straights, denser through turns.
DWC_RTK_ROAD_RECORD_SPACING_M=1.0
DWC_RTK_ROAD_TURN_RECORD_SPACING_M=0.5
DWC_RTK_ROAD_TURN_THRESHOLD_DEG=12.0

# Automatic route execution limits. The browser still requires manual confirmation.
DWC_RTK_ROUTE_MAX_DISTANCE_M=50.0
DWC_RTK_ROUTE_WAYPOINT_SPACING_M=2.0
DWC_RTK_ROUTE_WAYPOINT_TIMEOUT_SEC=45.0
DWC_RTK_NAV_STARTUP_TIMEOUT_SEC=20.0
DWC_RTK_FROM_LL_TIMEOUT_SEC=12.0
DWC_RTK_TF_READY_TIMEOUT_SEC=12.0
