# ROS 网络配置
ROS_MASTER_URI=http://localhost:11311
DWC_ROS_IP=127.0.0.1

# IoT 客户端 GPS / 代理配置
DWC_GPS_TOPIC=/gps/fix
DWC_GPS_STALE_SEC=10
DWC_USE_SYSTEM_PROXY=0

# 导航与建图配置
DWC_SLAM_MAP_DIR=/home/wheeltec/Dong/DevicesWebControl/slam_map
DWC_NAV_LOG_FILE=/tmp/devices_web_control_navigation.log
DWC_NAV_PREVIEW_MAX_SIZE=1000

# ROS 工作空间 setup.bash 路径
DWC_ROS_SETUP=/opt/ros/noetic/setup.bash
DWC_LIDAR_SETUP=/home/wheeltec/wheeltec_lidar/devel/setup.bash
DWC_WHEELTEC_SETUP=/home/wheeltec/wheeltec_robot/devel/setup.bash
