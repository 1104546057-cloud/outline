# MapLibre 可直接加载供应商提供的 Style JSON；配置后优先于单个栅格瓦片地址。
VITE_RTK_MAP_STYLE_URL=

# 未配置 Style URL 时使用。生产环境请替换为合法授权的卫星瓦片或自建正射影像。
VITE_RTK_RASTER_TILE_URL=https://your-authorized-tile-service/{z}/{x}/{y}.png
VITE_RTK_RASTER_ATTRIBUTION=Your imagery provider
VITE_RTK_MAP_PROVIDER_NAME=授权 WGS-84 卫星底图

# 校园道路网络和禁行区接入前，临时点选目标的最大允许距离。
VITE_RTK_DIRECT_GOAL_MAX_DISTANCE_M=10
VITE_RTK_ROAD_NETWORK_MAX_SNAP_M=5
